// MediaBoy music player, generated by internal/music/export.go.
//
// PCM: every channel DAC is on and every channel idle, so each outputs a
// constant; per sample the timer interrupt sets NR50 (volume per side) and
// NR51 (channels per side) from a level byte (see pcm.go). While PCM plays
// the timer is the only interrupt and the main loop waits in halt, so every
// sample goes out after the same delay; the screen is updated by polling LY
// at the start of VBlank instead of from the VBlank interrupt.
#include <gbdk/platform.h>
#include <gb/gb.h>
#include <gb/isr.h>
#include <stdint.h>
#include "{{.Name}}.h"

#define PCM_RATE {{.Rate}}UL
#define PCM_TMA {{.TMA}}
#define PCM_BANK_DATA {{.BankData}}UL
#define PCM_PER_BYTE {{if .DPCM}}2{{else}}1{{end}}
#define TILE_BAR_PART {{.TileBarPart}}
#define TILE_BAR_FULL {{.TileBarFull}}
#define TILE_BAR_EMPTY {{.TileBarEmpty}}
#define GLYPH_BASE {{.GlyphBase}}
#define FIXED_BASE {{.GlyphBase}}
#define FIXED_COUNT {{.FixedCount}}
#define BAR_X {{.BarX}}
#define BAR_Y {{.BarY}}
#define BAR_TILES {{.BarTiles}}
#define BAR_ROW {{.BarRow}}
#define TEXT_LEFT {{.TextLeft}}
#define TEXT_RIGHT {{.TextRight}}
#define CGB {{if .DMG}}0{{else}}1{{end}}
#define CODEC_PCM 0
#define CODEC_CHIP 1
#define CODEC_SILENT 2

// MBC5 bank, all 9 bits.
#define MAP_BANK(b) (*(volatile uint8_t *)0x3000 = (uint8_t)((uint16_t)(b) >> 8), *(volatile uint8_t *)0x2000 = (uint8_t)(b))

// Level tables on their own pages, so the ISR looks them up with l only.
uint8_t __at(0xD000) lvl_nr50[256];
uint8_t __at(0xD100) lvl_nr51[256];
uint8_t __at(0xD200) dpcm_step[16];
static const uint8_t dpcm_step_rom[16] = { {{range .DPCMSteps}}{{.}},{{end}} };
static const uint8_t lvl_nr50_rom[{{len .NR50}}] = { {{range .NR50}}{{.}},{{end}} };
static const uint8_t lvl_nr51_rom[{{len .NR51}}] = { {{range .NR51}}{{.}},{{end}} };

// Glyphs, bar pieces and the blank tile, loaded once at FIXED_BASE.
static const uint8_t fixed_tiles[] = { {{range .FixedTiles}}{{.}},{{end}} };
// The bar's partial tile with 0..8 pixels lit.
static const uint8_t bar_part[9][16] = { {{range .BarParts}}{ {{range .}}{{.}},{{end}} },{{end}} };
{{if not .DMG}}
// Shown instead of the player on a Game Boy without colour.
static const uint8_t cgb_only_tiles[] = { {{range .CGBOnlyTiles}}{{.}},{{end}} };
static const uint8_t cgb_only_map[] = { {{range .CGBOnlyMap}}{{.}},{{end}} };
static const palette_color_t ui_pal[4] = { {{range .UIPal}}{{.}},{{end}} };
static const palette_color_t spr_pal[4] = { {{range .SprPal}}{{.}},{{end}} };
{{end}}
{{.FreqTables}}

volatile const uint8_t *pcm_ptr;
volatile uint16_t pcm_bank;
volatile uint8_t pcm_ended;

{{if .DPCM}}
// One sample. It first puts out the registers the last interrupt worked out,
// so every sample goes out the same time after its interrupt whatever path
// the work takes; then the next sample: the next nibble's step added to
// pcm_level, a bank switch, or the end. pcm_half holds the second nibble of
// a byte (| $10), 0 when the next sample needs a new byte.
volatile uint8_t pcm_level;
volatile uint8_t pcm_half;
volatile uint8_t pcm_o50, pcm_o51;
void audio_isr(void) __naked {
__asm
        push af
        ld a, (_pcm_o50)
        ldh (0x24), a
        ld a, (_pcm_o51)
        ldh (0x25), a
        push hl
        ld a, (_pcm_half)
        or a
        jr nz, 00010$
00001$:
        ld hl, #_pcm_ptr
        ld a, (hl+)
        ld h, (hl)
        ld l, a
        ld a, (hl+)
        push de
        ld e, a
        and #0xF0
        cp #0x80
        jr z, 00002$
        ld a, l
        ld (_pcm_ptr), a
        ld a, h
        ld (_pcm_ptr+1), a
        ld a, e
        and #0x0F
        or #0x10
        ld (_pcm_half), a
        ld a, e
        swap a
        and #0x0F
        pop de
        jr 00011$
00010$:
        ld l, a
        ld a, #0x00
        ld (_pcm_half), a
        ld a, l
        and #0x0F
00011$:
        ld l, a
        ld h, #0xD2
        ld a, (_pcm_level)
        add a, (hl)
        ld (_pcm_level), a
        ld l, a
        ld h, #0xD0
        ld a, (hl)
        ld (_pcm_o50), a
        inc h
        ld a, (hl)
        ld (_pcm_o51), a
        pop hl
        pop af
        reti
00002$:
        ld a, e
        pop de
        cp #0x80
        jr nz, 00003$
        ; 0x80: the next bank
        ld hl, #_pcm_bank
        inc (hl)
        jr nz, 00004$
        inc hl
        inc (hl)
        dec hl
00004$:
        ld a, (hl+)
        push af
        ld a, (hl)
        ld (0x3000), a
        pop af
        ld (0x2000), a
        ld a, #0x00
        ld (_pcm_ptr), a
        ld a, #0x40
        ld (_pcm_ptr+1), a
        jr 00001$
00003$:
        ; the end. Stop the timer interrupt; the main loop moves on.
        ld a, #1
        ld (_pcm_ended), a
        ldh (0xFF), a
        pop hl
        pop af
        reti
__endasm;
}
{{else}}
// One sample. It first puts out the registers the last interrupt worked out,
// so every sample goes out the same time after its interrupt whatever path
// the work takes; then the next sample: the level byte at pcm_ptr, a bank
// switch, or the end.
volatile uint8_t pcm_o50, pcm_o51;
void audio_isr(void) __naked {
__asm
        push af
        ld a, (_pcm_o50)
        ldh (0x24), a
        ld a, (_pcm_o51)
        ldh (0x25), a
        push hl
        push de
00001$:
        ld hl, #_pcm_ptr
        ld a, (hl+)
        ld h, (hl)
        ld l, a
        ld a, (hl+)
        cp #0xF0
        jr nc, 00002$
        ld e, a
        ld a, l
        ld (_pcm_ptr), a
        ld a, h
        ld (_pcm_ptr+1), a
        ld h, #0xD0
        ld l, e
        ld a, (hl)
        ld (_pcm_o50), a
        inc h
        ld a, (hl)
        ld (_pcm_o51), a
        pop de
        pop hl
        pop af
        reti
00002$:
        jr nz, 00003$
        ; 0xF0: the next bank
        ld hl, #_pcm_bank
        inc (hl)
        jr nz, 00004$
        inc hl
        inc (hl)
        dec hl
00004$:
        ld a, (hl+)
        ld e, a
        ld a, (hl)
        ld (0x3000), a
        ld a, e
        ld (0x2000), a
        ld a, #0x00
        ld (_pcm_ptr), a
        ld a, #0x40
        ld (_pcm_ptr+1), a
        jr 00001$
00003$:
        ; 0xFF: the end. Stop the timer interrupt; the main loop moves on.
        ld a, #1
        ld (_pcm_ended), a
        ldh (0xFF), a
        pop de
        pop hl
        pop af
        reti
__endasm;
}
{{end}}
ISR_VECTOR(VECTOR_TIMER, audio_isr)

static uint8_t current;
static uint8_t cur_codec;  // CODEC_PCM, CODEC_CHIP or CODEC_SILENT
static uint8_t playing;
static uint8_t in_vbl;
static uint8_t seen_ticks;
static uint8_t ui_dirty;   // redraw the status and the bar
static uint16_t shown_secs;
static uint8_t shown_px;

static void apu_pcm(void) {
    NR52_REG = 0x80;
    NR50_REG = 0x00;
    NR51_REG = 0x00;
    // DACs off stops whatever played; on again, the channels stay idle.
    NR12_REG = 0x00; NR22_REG = 0x00; NR30_REG = 0x00; NR42_REG = 0x00;
    NR12_REG = 0x08; NR22_REG = 0x08; NR30_REG = 0x80; NR42_REG = 0x08;
    TMA_REG = PCM_TMA;
    TAC_REG = 0x05;
}

// ── Chiptune: a 60 Hz note stream on the native channels ──────────────────
static volatile uint8_t chip_playing;
static volatile uint8_t chip_ended;
static volatile const uint8_t *chip_ptr;
static volatile const uint8_t *chip_chunk_endp;
static volatile uint16_t chip_chunk;
static volatile uint16_t chip_frame;
static volatile uint16_t chip_total;

static void chip_load_chunk(void) {
    MAP_BANK(chip_chunk_bank[chip_chunk]);
    chip_ptr = chip_chunk_ptr[chip_chunk];
    chip_chunk_endp = chip_ptr + chip_chunk_len[chip_chunk];
}

static const uint8_t chip_wave[16] = {
    0x01,0x23,0x45,0x67,0x89,0xAB,0xCD,0xEF,0xFE,0xDC,0xBA,0x98,0x76,0x54,0x32,0x10
};

static void chip_pulse1(uint8_t note) {
    if (note == 0) { NR12_REG = 0x00; return; }
    uint16_t f = pulse_freq[note];
    NR11_REG = 0x80; NR12_REG = 0xF0;
    NR13_REG = (uint8_t)f; NR14_REG = 0x80 | (uint8_t)(f >> 8);
}
static void chip_pulse2(uint8_t note) {
    if (note == 0) { NR22_REG = 0x00; return; }
    uint16_t f = pulse_freq[note];
    NR21_REG = 0x80; NR22_REG = 0xF0;
    NR23_REG = (uint8_t)f; NR24_REG = 0x80 | (uint8_t)(f >> 8);
}
static void chip_wavech(uint8_t note) {
    if (note == 0) { NR30_REG = 0x00; return; }
    uint16_t f = wave_freq[note];
    NR30_REG = 0x80; NR32_REG = 0x20;
    NR33_REG = (uint8_t)f; NR34_REG = 0x80 | (uint8_t)(f >> 8);
}
static void chip_noise(uint8_t v) {
    if (v == 0) return;
    NR41_REG = 0x00; NR42_REG = 0xF1; NR43_REG = 0x33; NR44_REG = 0x80;
}

// vbl_ticks counts VBlank interrupts. When the CPU only wakes for those
// (chiptune, pause) it never sees LY below 144, so a tick marks a new frame.
static volatile uint8_t vbl_ticks;

// chip_vbl plays one record per frame (control byte + changed values).
void chip_vbl(void) {
    uint8_t ctrl;
    vbl_ticks++;
    if (!chip_playing) return;
    if (chip_frame >= chip_total) {
        chip_playing = 0;
        chip_ended = 1;
        return;
    }
    if (chip_ptr >= chip_chunk_endp) {
        chip_chunk++;
        chip_load_chunk();
    } else {
        MAP_BANK(chip_chunk_bank[chip_chunk]);
    }
    ctrl = *chip_ptr++;
    if (ctrl & 1) chip_pulse1(*chip_ptr++);
    if (ctrl & 2) chip_pulse2(*chip_ptr++);
    if (ctrl & 4) chip_wavech(*chip_ptr++);
    if (ctrl & 8) chip_noise(*chip_ptr++);
    chip_frame++;
}

static void chip_setup(void) {
    NR52_REG = 0x80;
    NR51_REG = 0xFF;
    NR50_REG = 0x77;
    NR30_REG = 0x00;
    for (uint8_t k = 0; k < 16; k++) AUD3WAVE[k] = chip_wave[k];
}

// ── Transport ─────────────────────────────────────────────────────────────
static void audio_pause(void) {
    set_interrupts(VBL_IFLAG); // output holds its level: no click
    chip_playing = 0;
    playing = 0;
    ui_dirty = 1;
}

static void audio_resume(void) {
    if (cur_codec == CODEC_SILENT) return;
    if (cur_codec == CODEC_CHIP) {
        if (chip_ended) return;
        chip_setup();
        chip_playing = 1;
        playing = 1;
        set_interrupts(VBL_IFLAG);
    } else {
        if (pcm_ended) return;
        MAP_BANK(pcm_bank);
        playing = 1;
        set_interrupts(TIM_IFLAG);
    }
    ui_dirty = 1;
}

static void audio_start(uint8_t i) {
    audio_pause();
    cur_codec = song_codec[i];
    if (cur_codec == CODEC_SILENT) return;
    if (cur_codec == CODEC_CHIP) {
        chip_ended = song_chip_frames[i] == 0;
        chip_chunk = song_chip_first[i];
        chip_frame = 0;
        chip_total = song_chip_frames[i];
        if (!chip_ended) chip_load_chunk();
    } else {
        apu_pcm();
        pcm_bank = song_pcm_bank[i];
        pcm_ptr = (const uint8_t *)0x4000;
        pcm_ended = 0;
        pcm_o50 = 0;
        pcm_o51 = 0;
{{- if .DPCM}}
        pcm_level = 0;
        pcm_half = 0;
{{- end}}
    }
    audio_resume();
}

// ── Screen ────────────────────────────────────────────────────────────────
#define OAM ((volatile uint8_t *)0xFE00)
#define SLOT_ICON 0
#define SLOT_TRACK 1
#define SLOT_TOTAL 6
#define SLOT_ELAPSED 11
#define SLOTS 16

// The screen changes are worked out during the frame and copied in at the
// start of the next VBlank: OAM and VRAM are only open then, and with the
// sample interrupt taking half the CPU only a few bytes fit. So only the
// bytes that changed are queued (the time's digits, the bar's cell and its
// two pixel rows).
static uint8_t oam_shadow[SLOTS * 4];
static uint8_t oam_queue[SLOTS * 4];
static uint8_t oam_queued_flag[SLOTS * 4];
static uint8_t oam_queued;
static uint8_t bar_shown[BAR_TILES];
static uint8_t bar_map[BAR_TILES];
static const uint8_t *bar_src;
static uint8_t bar_dirty;

static void oam_set(uint8_t i, uint8_t v) {
    if (oam_shadow[i] == v) return;
    oam_shadow[i] = v;
    if (!oam_queued_flag[i]) {
        oam_queued_flag[i] = 1;
        oam_queue[oam_queued++] = i;
    }
}

static void spr(uint8_t slot, uint8_t x, uint8_t y, uint8_t tile) {
    slot <<= 2;
    oam_set(slot, y + 16);
    oam_set(slot + 1, x + 8);
    oam_set(slot + 2, tile);
}

static void spr_hide(uint8_t from, uint8_t to) {
    for (; from < to; from++) oam_set(from << 2, 0);
}

// flush copies the queued changes in; it runs first thing in VBlank.
static void flush(void) {
    uint8_t k;
    for (k = 0; k < oam_queued; k++) {
        uint8_t i = oam_queue[k];
        OAM[i] = oam_shadow[i];
        oam_queued_flag[i] = 0;
    }
    oam_queued = 0;
    if (bar_dirty) {
        volatile uint8_t *m = (volatile uint8_t *)0x9800 + BAR_Y * 32 + BAR_X;
        volatile uint8_t *t = (volatile uint8_t *)0x8000 + TILE_BAR_PART * 16 + 2 * BAR_ROW;
        bar_dirty = 0;
        t[0] = bar_src[2 * BAR_ROW];
        t[1] = bar_src[2 * BAR_ROW + 1];
        t[2] = bar_src[2 * BAR_ROW + 2];
        t[3] = bar_src[2 * BAR_ROW + 3];
        for (k = 0; k < BAR_TILES; k++) {
            if (bar_shown[k] != bar_map[k]) {
                bar_shown[k] = bar_map[k];
                m[k] = bar_map[k];
            }
        }
    }
}

// fmt_time writes m:ss and returns its length.
static uint8_t fmt_time(uint8_t *buf, uint16_t s) {
    uint16_t m = s / 60;
    uint8_t n = 0;
    s -= m * 60;
    if (m >= 100) m = 99;
    if (m >= 10) buf[n++] = GLYPH_BASE + m / 10;
    buf[n++] = GLYPH_BASE + m % 10;
    buf[n++] = (uint8_t)(GLYPH_BASE + 10);
    buf[n++] = GLYPH_BASE + s / 10;
    buf[n++] = GLYPH_BASE + s % 10;
    return n;
}

static uint8_t fmt_num(uint8_t *buf, uint8_t v) {
    uint8_t n = 0;
    if (v >= 10) buf[n++] = GLYPH_BASE + v / 10;
    buf[n++] = GLYPH_BASE + v % 10;
    return n;
}

// spr_text puts len glyphs from slot on, ending at x_end (or from x_start
// when x_end is 0), and hides the rest of its max slots.
static void spr_text(uint8_t slot, uint8_t max, uint8_t x, uint8_t y, const uint8_t *g, uint8_t len) {
    uint8_t k;
    for (k = 0; k < len; k++) spr(slot + k, x + (k << 3), y, g[k]);
    spr_hide(slot + len, slot + max);
}

static void draw_status(void) {
    uint8_t t[5], tot[5];
    uint8_t n = fmt_num(t, current + 1);
    t[n++] = (uint8_t)(GLYPH_BASE + 11);
    n += fmt_num(t + n, NUM_SONGS);
    uint8_t m = fmt_time(tot, song_secs[current]);
    spr(SLOT_ICON, TEXT_LEFT, 0, playing ? GLYPH_BASE + 12 : GLYPH_BASE + 13);
    spr_text(SLOT_TRACK, 5, TEXT_LEFT + 16, 0, t, n);
    if (1 + n + m <= 10) // sprites per line
        spr_text(SLOT_TOTAL, 5, TEXT_RIGHT - (m << 3), 0, tot, m);
    else
        spr_hide(SLOT_TOTAL, SLOT_TOTAL + 5);
}

static void draw_elapsed(uint16_t secs) {
    uint8_t e[5];
    uint8_t n = fmt_time(e, secs);
    spr_text(SLOT_ELAPSED, 5, TEXT_RIGHT - (n << 3), BAR_Y * 8, e, n);
}

static void draw_bar(uint8_t px) {
    uint8_t full = px >> 3, c;
    for (c = 0; c < BAR_TILES; c++)
        bar_map[c] = c < full ? TILE_BAR_FULL : (c == full ? TILE_BAR_PART : TILE_BAR_EMPTY);
    bar_src = bar_part[px & 7];
    bar_dirty = 1;
}

static uint16_t elapsed(void) {
    if (cur_codec == CODEC_SILENT) return 0;
    if (cur_codec == CODEC_CHIP) return chip_frame / 60;
    uint16_t b;
    const uint8_t *p;
    // No __critical: holding off the sample interrupt would make it late.
    // A pointer read torn by it is off for one frame at most.
    do {
        b = pcm_bank;
        p = (const uint8_t *)pcm_ptr;
    } while (b != pcm_bank);
    uint32_t pos = (uint32_t)(uint16_t)(b - song_pcm_bank[current]) * PCM_BANK_DATA + (uint16_t)((uint16_t)p - 0x4000u);
    return (uint16_t)(pos * PCM_PER_BYTE / PCM_RATE);
}

// wait_vblank_start waits for LY 144 when the screen is on.
static void wait_vblank_start(void) {
    if (!(LCDC_REG & LCDCF_ON)) return;
    while (LY_REG == 144) ;
    while (LY_REG != 144) ;
}

// load_song puts song i's cover and title on screen. Interrupts are off: the
// copies wait for VRAM access themselves, and nothing may delay them.
static void load_song(uint8_t i) {
    uint8_t n = song_ntiles[i];
    disable_interrupts();
    MAP_BANK(song_bank[i]);
#if CGB
    wait_vblank_start();
    set_bkg_palette(0, 7, song_pal[i]);
#endif
    if (n) set_bkg_data(0, n, song_tiles[i]);
    set_bkg_tiles(0, 0, 20, 18, song_map[i]);
#if CGB
    VBK_REG = 1;
    set_bkg_tiles(0, 0, 20, 18, song_attr[i]);
    VBK_REG = 0;
#endif
    // The whole status at once is more than a VBlank's worth of queued
    // bytes with the sample interrupt running; with interrupts off it fits.
    for (n = 0; n < BAR_TILES; n++) bar_shown[n] = TILE_BAR_EMPTY;
    current = i;
    draw_status();
    draw_elapsed(0);
    draw_bar(0);
    wait_vblank_start();
    flush();
    enable_interrupts();
    shown_secs = 0;
    shown_px = 0;
}

static void switch_track(uint8_t i) {
    audio_pause();
    current = i;
    load_song(i);
    audio_start(i);
}

static uint8_t prev_keys;

// frame runs at the start of every VBlank.
static void frame(void) {
    flush();
    if ((pcm_ended && cur_codec == CODEC_PCM) || (chip_ended && cur_codec == CODEC_CHIP)) {
        switch_track(current + 1 < NUM_SONGS ? current + 1 : 0);
        return;
    }
    uint8_t j = joypad();
    uint8_t pressed = j & ~prev_keys;
    prev_keys = j;
    if (pressed & J_LEFT) {
        switch_track(current ? current - 1 : NUM_SONGS - 1);
        return;
    }
    if (pressed & J_RIGHT) {
        switch_track(current + 1 < NUM_SONGS ? current + 1 : 0);
        return;
    }
    if (pressed & (J_A | J_START)) {
        if (playing) audio_pause(); else audio_resume();
    }
    if (pressed & J_B) {
        audio_start(current);
        shown_secs = 0xFFFF;
        shown_px = 0xFF;
    }

    if (ui_dirty) {
        ui_dirty = 0;
        draw_status();
    }
    uint16_t s = elapsed();
    if (s != shown_secs) {
        shown_secs = s;
        draw_elapsed(s);
        uint16_t total = song_secs[current];
        uint8_t px = total ? (uint8_t)((uint32_t)s * (BAR_TILES * 8) / total) : 0;
        if (px > BAR_TILES * 8) px = BAR_TILES * 8;
        if (px != shown_px) {
            shown_px = px;
            draw_bar(px);
        }
    }
}

void main(void) {
    uint16_t k;
    DISPLAY_OFF;
#if CGB
    if (_cpu != CGB_TYPE) {
        // No second VRAM bank, no double speed: say so instead of garbling.
        BGP_REG = DMG_PALETTE(DMG_WHITE, DMG_LITE_GRAY, DMG_DARK_GRAY, DMG_BLACK);
        set_bkg_data(0, {{.CGBOnlyCount}}, cgb_only_tiles);
        set_bkg_tiles(0, 0, 20, 18, cgb_only_map);
        SHOW_BKG;
        DISPLAY_ON;
        disable_interrupts();
        while (1) {
            __asm
                halt
                nop
            __endasm;
        }
    }
    cpu_fast();
#endif
    for (k = 0; k < sizeof(lvl_nr50_rom); k++) {
        lvl_nr50[k] = lvl_nr50_rom[k];
        lvl_nr51[k] = lvl_nr51_rom[k];
    }
    for (k = 0; k < 16; k++) dpcm_step[k] = dpcm_step_rom[k];
    set_bkg_data(FIXED_BASE, FIXED_COUNT, fixed_tiles);
#if CGB
    set_bkg_palette(7, 1, ui_pal);
    set_sprite_palette(0, 1, spr_pal);
#else
    BGP_REG = DMG_PALETTE(DMG_WHITE, DMG_LITE_GRAY, DMG_DARK_GRAY, DMG_BLACK);
    OBP0_REG = 0x00;
#endif
    DISABLE_OAM_DMA; // the VBlank interrupt must not copy GBDK's shadow OAM over ours
    for (k = 0; k < 160; k++) OAM[k] = 0;
    SPRITES_8x8;

    current = 0;
    load_song(0);
    SHOW_BKG;
    SHOW_SPRITES;
    DISPLAY_ON;

    add_VBL(chip_vbl);
    set_interrupts(VBL_IFLAG);
    enable_interrupts();
    audio_start(0);

    while (1) {
        __asm
            halt
            nop
        __endasm;
        if (LY_REG >= 144) {
            if (!in_vbl || seen_ticks != vbl_ticks) {
                in_vbl = 1;
                seen_ticks = vbl_ticks;
                frame();
            }
        } else {
            in_vbl = 0;
        }
    }
}
